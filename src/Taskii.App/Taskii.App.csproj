<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>Taskii.App</RootNamespace>
    <AssemblyName>Taskii</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\taskii.ico</ApplicationIcon>
    <UseWinUI>true</UseWinUI>

    <!-- A plain exe: no MSIX package, and the Windows App SDK ships beside it. -->
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <Platforms>x64;ARM64</Platforms>
    <!-- One output folder whether the project or the solution is built. -->
    <AppendPlatformToOutputPath>false</AppendPlatformToOutputPath>
    <HostArchitecture>$([System.Runtime.InteropServices.RuntimeInformation]::OSArchitecture.ToString().ToLowerInvariant())</HostArchitecture>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-$(HostArchitecture)</RuntimeIdentifier>

    <!-- Program.cs has the entry point, so it can hand over to an instance that is already running. -->
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" />
    <ProjectReference Include="..\Taskii.Core\Taskii.Core.csproj" />
    <Content Include="Assets\taskii.ico" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!--
    The page shown in the window is built from src/web with pnpm and copied to wwwroot beside
    the exe. It is rebuilt only when its sources change.
  -->
  <PropertyGroup>
    <WebDir>$(MSBuildThisFileDirectory)..\web\</WebDir>
  </PropertyGroup>

  <ItemGroup>
    <WebInput Include="$(WebDir)src\**\*;$(WebDir)index.html;$(WebDir)package.json;$(WebDir)pnpm-lock.yaml;$(WebDir)vite.config.ts;$(WebDir)tsconfig.json" />
  </ItemGroup>

  <Target Name="InstallWeb" BeforeTargets="BuildWeb" Inputs="$(WebDir)pnpm-lock.yaml" Outputs="$(WebDir)node_modules\.modules.yaml">
    <Exec Command="pnpm install --frozen-lockfile" WorkingDirectory="$(WebDir)" />
  </Target>

  <Target Name="BuildWeb" BeforeTargets="BeforeBuild" Inputs="@(WebInput)" Outputs="$(WebDir)dist\index.html">
    <Exec Command="pnpm run build" WorkingDirectory="$(WebDir)" />
    <Touch Files="$(WebDir)dist\index.html" />
  </Target>

  <Target Name="CopyWeb" AfterTargets="Build">
    <ItemGroup>
      <WebOutput Include="$(WebDir)dist\**\*" />
    </ItemGroup>
    <RemoveDir Directories="$(OutDir)wwwroot" />
    <Copy SourceFiles="@(WebOutput)" DestinationFiles="@(WebOutput->'$(OutDir)wwwroot\%(RecursiveDir)%(Filename)%(Extension)')" />
  </Target>

  <Target Name="PublishWeb" AfterTargets="Publish">
    <ItemGroup>
      <WebPublish Include="$(WebDir)dist\**\*" />
    </ItemGroup>
    <RemoveDir Directories="$(PublishDir)wwwroot" />
    <Copy SourceFiles="@(WebPublish)" DestinationFiles="@(WebPublish->'$(PublishDir)wwwroot\%(RecursiveDir)%(Filename)%(Extension)')" />
  </Target>

</Project>
