<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RootNamespace>Taskii.Cli</RootNamespace>
    <!-- Not "taskii": the app is Taskii.exe, and on Windows the two would collide in one folder. -->
    <AssemblyName>taskii-cli</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Taskii.Core\Taskii.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Taskii.Cli.Tests" />
  </ItemGroup>

</Project>
